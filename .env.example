# ==============================================================================
# ALYA ASSISTANT - ENVIRONMENT CONFIGURATION (OPTIONAL)
# ==============================================================================
# Alya Assistant is 100% Free & Open-Source and functions fully on-device
# without requiring any environment variables, API keys, or external servers.

# SUPABASE_URL: (Optional) Your private Supabase project URL for multi-device sync
SUPABASE_URL=YOUR_SUPABASE_URL

# SUPABASE_ANON_KEY: (Optional) Your private Supabase project anonymous key
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
